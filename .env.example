POSTGRES_DB=auction
POSTGRES_USER=auction_user
# Обязательно замените оба значения. Секрет: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
# true — если сайт открывается по HTTPS (cookie сессии получат флаг Secure). В production — true.
COOKIE_SECURE=false
# Access-токен (JWT, HS256, 15 мин): значения claims iss и aud. Менять не обязательно;
# при смене все выданные токены станут недействительными.
JWT_ISSUER=auction
JWT_AUDIENCE=auction-web
# Origin фронтенда через запятую, если он открывается НЕ с того же хоста, что API
# (CORS с cookie + разрешение изменяющих запросов). Свой хост разрешён всегда. «*» нельзя.
# Пример: https://app.example.com,http://localhost:5173
ALLOWED_ORIGINS=
# Сколько секунд повтор только что использованного refresh-токена считается гонкой вкладок
# (ответ 409), а не кражей (отзыв сессии). 0 — строгий режим, максимум 60.
REFRESH_REUSE_GAP_SEC=10
# Anti-snipe: ставка за последние WINDOW секунд до конца переносит конец на «сейчас + EXTEND».
# WINDOW=0 выключает защиту. По умолчанию 120 и 120.
ANTI_SNIPE_WINDOW_SEC=120
ANTI_SNIPE_EXTEND_SEC=120
# Доп. источники (Origin) для WebSocket через запятую; свой домен разрешён всегда.
# Нужно, только если фронтенд открывается с другого домена. Пример: https://auction.example.com
WS_ALLOWED_ORIGINS=
